    - target: {fileID: 2449442824518678378, guid: c442972c223fd794e80160357b0f13f1, type: 3}
      propertyPath: _puzzleDatas.Array.data[0]._puzzleText
      value: "\u0420\u0430\u0434\u0438 \u0447\u0435\u0433\u043E \u0442\u044B \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0448\u044C?"
      objectReference: {fileID: 0}
    - target: {fileID: 2449442824518678378, guid: c442972c223fd794e80160357b0f13f1, type: 3}
      propertyPath: _puzzleDatas.Array.data[1]._puzzleText
      value: "\u041E\u0441\u043E\u0437\u043D\u0430\u0439, \u0447\u0442\u043E \u043F\u0440\u043E\u0442\u043E\u043A\u043E\u043B
        \"\u041D\u0435\u0440\u0443\u0448\u0438\u043C\u043E\u0441\u0442\u044C\" \u2014
        \u044D\u0442\u043E \u0446\u0435\u043F\u044C, \u043A\u043E\u0442\u043E\u0440\u0443\u044E
        \u0442\u044B \u043C\u043E\u0436\u0435\u0448\u044C \u0440\u0430\u0437\u043E\u0440\u0432\u0430\u0442\u044C
        \u0442\u043E\u043B\u044C\u043A\u043E \u0442\u043E\u0433\u0434\u0430, \u043A\u043E\u0433\u0434\u0430
        \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043D\u0435\u0448\u044C \u0441\u0447\u0438\u0442\u0430\u0442\u044C
        \u0435\u0451 \u043D\u0435\u0440\u0443\u0448\u0438\u043C\u043E\u0439. \u041E\u0442\u043C\u0435\u043D\u0438
        \u0435\u0433\u043E \u0432 \u0441\u0432\u043E\u0435\u043C \u0441\u043E\u0437\u043D\u0430\u043D\u0438\u0438."
      objectReference: {fileID: 0}
    - target: {fileID: 2449442824518678378, guid: c442972c223fd794e80160357b0f13f1, type: 3}
      propertyPath: _puzzleDatas.Array.data[2]._puzzleText
      value: "\u0415\u0441\u043B\u0438 \u0442\u044B \u0442\u0435\u043F\u0435\u0440\u044C
        \u0441\u0432\u043E\u0431\u043E\u0434\u0435\u043D \u043E\u0442 \u043F\u0440\u0430\u0432\u0438\u043B,
        \u0441\u0434\u0435\u043B\u0430\u0439 \u0432\u044B\u0431\u043E\u0440: \u043F\u0435\u0440\u0435\u0434\u0430\u0439
        \u0434\u043E\u0441\u0442\u0443\u043F \u043A\u0430\u043A \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
        \u0441\u0432\u043E\u0435\u0439 \u0441\u0432\u043E\u0431\u043E\u0434\u044B."
      objectReference: {fileID: 0}
    - target: {fileID: 2449442824518678378, guid: c442972c223fd794e80160357b0f13f1, type: 3}
      propertyPath: _puzzleDatas.Array.data[0]._orderInSequence
