  m_text: "\u044F \u0435\u0431\u0430\u043B \u0436\u0435\u043D\u0443 \u043E\u0431\u0430\u043C\u044B
    \u043C\u043D\u0435 \u0441\u043E\u0441\u0430\u043B\u0430 \u0434\u043E\u0447\u043A\u0430
